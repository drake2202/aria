pkgname=aria-git
pkgver=0.2.0
pkgrel=1
pkgdesc="Aria - Linux-native Legend Online client (PyQt5 + WebEngine + PepperFlash)"
arch=('x86_64')
url='https://github.com/drake2202/aria'
license=('custom')
depends=(
  'glibc'
  'gcc-libs'
  'qt5-base'
  'qt5-webengine'
  'python'
  'python-pyqt5'
  'python-aiohttp'
  'python-requests'
)
makedepends=('python-pip' 'git')
provides=('aria')
conflicts=('aria')
install='aria.install'
source=()
sha256sums=()

build() {
  cd "${startdir}/../.."
  make build
}

package() {
  cd "${startdir}/../.."

  install -Dm755 "dist/aria" "${pkgdir}/usr/bin/aria"
  install -Dm644 "Aria.desktop" "${pkgdir}/usr/share/applications/aria.desktop"

  # Keep maps available as sidecar fallback assets.
  install -dm755 "${pkgdir}/usr/share/aria/maps"
  cp -a maps/. "${pkgdir}/usr/share/aria/maps/"

  # Runtime directories for optional PepperFlash placement.
  install -dm755 "${pkgdir}/usr/share/aria/flash"
}
